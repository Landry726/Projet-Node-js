DB_NAME=GestionClient

# L'utilisateur de la base de données
DB_USER=postgres

# Le mot de passe de l'utilisateur
DB_PASS=admin

# L'hôte (souvent localhost ou 127.0.0.1)
DB_HOST=localhost

# Le dialecte de la base de données (garder "postgres")
DB_DIALECT=postgres

# Le port de la base de données (5432 pour PostgreSQL)
DB_PORT=5432